{
  "name": "rebeat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "fmt": "prettier --write .",
    "e2e": "playwright test",
    "desktop:build": "tsc -p electron/tsconfig.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.5",
    "dexie": "^4.4.6",
    "dockview-react": "^8.4.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "signalsmith-stretch": "^1.3.2",
    "smplr": "^1.1.0",
    "tailwindcss": "^4.3.3",
    "tone": "^15.1.22",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1",
    "wavesurfer.js": "^8.0.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.15"
  },
  "packageManager": "pnpm@12.9.1",
  "main": "electron/dist/main.cjs",
  "description": "A browser music IDE: drum machine, loop station, sample library and editor.",
  "author": "Jeroen Janssens",
  "build": {
    "appId": "com.jeroenjanssens.rebeat",
    "productName": "Rebeat",
    "copyright": "Copyright \u00a9 2026 Jeroen Janssens",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "rebeat",
        "name": "Rebeat project",
        "role": "Editor",
        "mimeType": "application/x-rebeat"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "electron/build/entitlements.mac.plist",
      "entitlementsInherit": "electron/build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Rebeat records loops and samples from your microphone."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jeroenjanssens",
        "repo": "rebeat",
        "private": true,
        "releaseType": "draft"
      }
    ]
  }
}
